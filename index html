HTML

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101010">
<title>MBM Stream — Music from Eswatini</title>
<style>
:root {
  --bg: #0c0c0e;
  --panel: #17171b;
  --gold: #e6bd69;
  --muted: #aaaab4;
  --white: #f7f5f0;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--white);
  font-family: Arial, sans-serif;
}
header, main, footer {
  max-width: 900px;
  margin: auto;
  padding: 20px;
}
header { border-bottom: 1px solid #333; }
.brand { display: flex; align-items: center; gap: 12px; }
.logo {
  background: var(--gold);
  color: #111;
  padding: 12px 16px;
  border-radius: 12px;
  font-size: 24px;
  font-weight: bold;
}
h1 { font-size: 23px; margin: 0; }
.tagline, .muted { color: var(--muted); font-size: 13px; }
nav { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
a { color: var(--gold); }
nav a { text-decoration: none; }
.hero {
  margin: 25px 0;
  padding: 30px 22px;
  border-radius: 20px;
  background: linear-gradient(135deg, #302719, #17171b);
}
.eyebrow {
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 12px;
}
h2 { font-size: clamp(32px, 8vw, 48px); margin: 15px 0; }
button {
  border: 0;
  border-radius: 10px;
  background: var(--gold);
  color: #17130a;
  padding: 12px 16px;
  font-weight: bold;
  cursor: pointer;
}
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 14px;
}
.card {
  background: var(--panel);
  border: 1px solid #303036;
  padding: 12px;
  border-radius: 15px;
  min-width: 0;
}
.art {
  aspect-ratio: 1;
  border-radius: 12px;
  background: linear-gradient(135deg, #49391b, #222228);
  display: grid;
  place-items: center;
  color: var(--gold);
  font-size: 45px;
  margin-bottom: 12px;
}
.song-title { font-weight: bold; overflow-wrap: anywhere; }
.artist { color: var(--muted); font-size: 13px; margin: 6px 0 12px; }
.card button { width: 100%; }
.panel {
  background: var(--panel);
  border: 1px solid #303036;
  border-radius: 15px;
  padding: 18px;
  margin: 15px 0;
}
input {
  width: 100%;
  padding: 12px;
  margin: 10px 0;
}
audio { width: 100%; }
footer {
  color: var(--muted);
  font-size: 12px;
  border-top: 1px solid #333;
}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="logo">M</div>
    <div>
      <h1>MBM STREAM</h1>
      <div class="tagline">Music from Eswatini to the world</div>
    </div>
  </div>
  <nav>
    <a href="#discover">Discover</a>
    <a href="#artists">Artists</a>
    <a href="#music">My music</a>
    <a href="#about">About</a>
  </nav>
</header>

<main>
  <section class="hero">
    <div class="eyebrow">Independent music · Eswatini</div>
    <h2>Your sound.<br>Our home.</h2>
    <p>Discover music and support independent artists. MBM Stream begins with music from Yung Baya Eswatini.</p>
    <a href="#discover"><button>Explore music ♫</button></a>
  </section>

  <section id="discover">
    <h2 style="font-size:24px">Discover music</h2>
    <p class="muted">Founder catalogue · Add your songs below</p>
    <div class="cards" id="trackCards">
      <div class="card">
        <div class="art">♫</div>
        <div class="song-title">Your first song</div>
        <div class="artist">Yung Baya Eswatini</div>
        <button onclick="chooseSong(0)">▶ Play</button>
      </div>
      <div class="card">
        <div class="art">♪</div>
        <div class="song-title">Your second song</div>
        <div class="artist">Yung Baya Eswatini</div>
        <button onclick="chooseSong(1)">▶ Play</button>
      </div>
      <div class="card">
        <div class="art">♫</div>
        <div class="song-title">Your third song</div>
        <div class="artist">Yung Baya Eswatini</div>
        <button onclick="chooseSong(2)">▶ Play</button>
      </div>
    </div>
  </section>

  <section id="music">
    <h2 style="font-size:24px">Add your music</h2>
    <div class="panel">
      <p class="muted">Choose audio files on your phone to test the player. These files are not uploaded to the internet.</p>
      <input id="audioFiles" type="file" accept="audio/*" multiple>
      <button onclick="loadSongs()">Load selected songs</button>
      <p id="status" class="muted">No songs selected yet.</p>
    </div>
  </section>

  <section id="artists">
    <h2 style="font-size:24px">Featured artist</h2>
    <div class="panel">
      <h3>Yung Baya Eswatini</h3>
      <p class="muted">Independent artist · Songwriter · Eswatini</p>
    </div>
  </section>

  <section id="about">
    <h2 style="font-size:24px">About MBM Stream</h2>
    <div class="panel">
      <p class="muted">MBM Stream is an independent music platform project based in Eswatini. This starter website is a demonstration. Online audio hosting, artist memberships, paid releases and royalty payments are not active yet.</p>
      <p class="muted">Only music that you own or have permission to share should be published.</p>
    </div>
  </section>

  <section class="panel">
    <div id="nowPlaying" class="song-title">MBM Stream player</div>
    <audio id="player" controls preload="none"></audio>
  </section>
</main>

<footer>
  © <span id="year"></span> MBM Stream · Independent music from Eswatini
</footer>

<script>
const player = document.getElementById("player");
const nowPlaying = document.getElementById("nowPlaying");
const cards = document.getElementById("trackCards");
let tracks = [];
let objectUrls = [];

document.getElementById("year").textContent = new Date().getFullYear();

function chooseSong(index) {
  if (!tracks[index]) {
    document.getElementById("audioFiles").click();
    document.getElementById("status").textContent =
      "Choose your songs, then tap Load selected songs.";
    return;
  }
  player.src = tracks[index].url;
  nowPlaying.textContent = "Now playing: " + tracks[index].title;
  player.play().catch(() => {});
}

function loadSongs() {
  const files = Array.from(
    document.getElementById("audioFiles").files
  ).slice(0, 20);

  if (!files.length) {
    document.getElementById("status").textContent =
      "Please select at least one audio file.";
    return;
  }

  objectUrls.forEach(url => URL.revokeObjectURL(url));
  objectUrls = [];
  tracks = files.map(file => {
    const url = URL.createObjectURL(file);
    objectUrls.push(url);
    return {
      title: file.name.replace(/\.[^/.]+$/, ""),
      url
    };
  });

  cards.innerHTML = "";

  tracks.forEach((track, index) => {
    const card = document.createElement("div");
    card.className = "card";

    const art = document.createElement("div");
    art.className = "art";
    art.textContent = "♫";

    const title = document.createElement("div");
    title.className = "song-title";
    title.textContent = track.title;

    const artist = document.createElement("div");
    artist.className = "artist";
    artist.textContent = "Yung Baya Eswatini";

    const button = document.createElement("button");
    button.textContent = "▶ Play";
    button.onclick = () => chooseSong(index);

    card.append(art, title, artist, button);
    cards.append(card);
  });

  document.getElementById("status").textContent =
    tracks.length + " song(s) loaded for local testing.";

  chooseSong(0);
}
</script>
</body>
</html>
